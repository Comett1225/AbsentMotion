<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="fonts/google" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="fonts/google" />
    </device-transfer>
</data-extraction-rules>
