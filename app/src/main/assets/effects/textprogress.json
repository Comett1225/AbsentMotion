{
 "id": "textprogress",
 "name": "Text Progress",
 "category": "text",
 "since": "3.0.0",
 "native": true,
 "description": "Shows a text layer piece by piece, by character, word or line, each piece popping, fading, sliding, growing, shrinking or sharpening into place.",
 "params": [
  {
   "id": "progress",
   "label": "Progress",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 1,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "unit",
   "label": "Based On",
   "type": "choice",
   "default": 0,
   "options": [
    "Character",
    "Word",
    "Line"
   ]
  },
  {
   "id": "direction",
   "label": "Direction",
   "type": "choice",
   "default": 0,
   "options": [
    "From Start",
    "From End",
    "From Center",
    "Random"
   ]
  },
  {
   "id": "appearance",
   "label": "Appear As",
   "type": "choice",
   "default": 1,
   "options": [
    "Pop",
    "Fade",
    "Slide Up",
    "Slide Down",
    "Slide Left",
    "Slide Right",
    "Grow",
    "Shrink",
    "Blur"
   ]
  },
  {
   "id": "softness",
   "label": "Softness",
   "type": "float",
   "default": 0,
   "min": 0,
   "max": 50,
   "step": 0.1
  },
  {
   "id": "distance",
   "label": "Distance",
   "type": "float",
   "default": 40,
   "min": 0,
   "max": 1000,
   "step": 0.1
  },
  {
   "id": "seed",
   "label": "Seed",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 1000,
   "step": 1
  }
 ]
}
