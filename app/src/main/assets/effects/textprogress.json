   "id": "progress",
   "label": "Progress",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 1,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "unit",
   "label": "Based On",
   "type": "choice",
   "default": 0,
   "options": [
    "Character",
    "Word",
    "Line"
   ]
  },
  {
   "id": "direction",
   "label": "Direction",
   "type": "choice",
   "default": 0,
   "options": [
    "From Start",
    "From End",
    "From Center",
    "Random"
   ]
  },
  {
   "id": "appearance",
   "label": "Appear As",
   "type": "choice",
   "default": 1,
   "options": [
    "Pop",
    "Fade",
    "Slide Up",
    "Slide Down",
    "Slide Left",
    "Slide Right",
    "Grow",
    "Shrink",
    "Blur"
   ]
  },
  {
   "id": "softness",
