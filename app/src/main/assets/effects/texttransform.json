{
 "id": "texttransform",
 "name": "Text Transform",
 "category": "text",
 "since": "3.0.0",
 "native": true,
 "description": "Moves, scales, turns, fades and tints the letters, words or lines of a text layer that fall inside a range. Move the range with Offset to make the change travel through the text.",
 "params": [
  {
   "id": "unit",
   "label": "Based On",
   "type": "choice",
   "default": 0,
   "options": [
    "Character",
    "Word",
    "Line"
   ]
  },
  {
   "id": "start",
   "label": "Start",
   "type": "float",
   "default": 0,
   "min": 0,
   "max": 1,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "end",
   "label": "End",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 1,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "offset",
   "label": "Offset",
   "type": "float",
   "default": 0,
   "min": -2,
   "max": 2,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "shape",
   "label": "Shape",
   "type": "choice",
   "default": 0,
   "options": [
    "Square",
    "Ramp Up",
    "Ramp Down",
    "Triangle",
    "Round",
    "Smooth"
   ]
  },
  {
   "id": "smoothness",
   "label": "Smoothness",
   "type": "float",
   "default": 0,
   "min": 0,
   "max": 1,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "position",
   "label": "Position",
   "type": "point",
   "default": [
    0,
    0
   ],
   "min": -4000,
   "max": 4000,
   "step": 0.1,
   "pixels": true
  },
  {
   "id": "scale",
   "label": "Scale",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 10,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "rotation",
   "label": "Rotation",
   "type": "angle",
   "default": 0,
   "min": -3600,
   "max": 3600,
   "step": 0.1
  },
  {
   "id": "opacity",
   "label": "Opacity",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 1,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "tint",
   "label": "Tint",
   "type": "color",
   "default": "#00ffffff"
  },
  {
   "id": "randomOrder",
   "label": "Random Order",
   "type": "switch",
   "default": false
  },
  {
   "id": "seed",
   "label": "Seed",
   "type": "float",
   "default": 1,
   "min": 0,
   "max": 1000,
   "step": 1
  }
 ]
}
