{
 "id": "timecode",
 "name": "Timecode",
 "category": "text",
 "since": "3.0.0",
 "native": true,
 "description": "Replaces the text of a layer with a running clock of the layer or project time. Start At and a negative Speed make a countdown.",
 "params": [
  {
   "id": "format",
   "label": "Format",
   "type": "choice",
   "default": 0,
   "options": [
    "HH:MM:SS:FF",
    "HH:MM:SS",
    "MM:SS",
    "MM:SS.hh",
    "SS.hh",
    "Frames"
   ]
  },
  {
   "id": "source",
   "label": "Time",
   "type": "choice",
   "default": 0,
   "options": [
    "Layer",
    "Project"
   ]
  },
  {
   "id": "offset",
   "label": "Start At",
   "type": "float",
   "default": 0,
   "min": -360000,
   "max": 360000,
   "step": 0.01
  },
  {
   "id": "speed",
   "label": "Speed",
   "type": "float",
   "default": 1,
   "min": -100,
   "max": 100,
   "step": 0.01
  }
 ]
}
