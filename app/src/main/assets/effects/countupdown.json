   "default": 0,
   "min": -100000,
   "max": 100000,
   "step": 0.01
  },
  {
   "id": "multiply",
   "label": "Multiply",
   "type": "float",
   "default": 1,
   "min": -2,
   "max": 2,
   "step": 0.001,
   "percent": true
  },
  {
   "id": "decimals",
