   "default": 0,
   "options": [
    "As Typed",
    "0",
    "1",
    "2",
    "3"
   ]
  },
  {
   "id": "separator",
   "label": "Thousands",
   "type": "choice",
   "default": 0,
   "options": [
    "1000.5",
    "1,000.5",
    "1.000,5",
    "1 000.5"
   ]
  }
 ]
