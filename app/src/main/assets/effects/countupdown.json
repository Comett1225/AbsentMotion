 "name": "Count Up/Down",
 "category": "text",
 "since": "3.0.0",
 "native": true,
 "description": "Changes every number in a text layer: multiplies it and adds to it, so keyframing Multiply from 0% to 100% counts up to the number you typed. Words around the numbers stay as they are.",
