{
  "photos": {
    "portrait": {"commons": "File:Fishmonger smiling.jpg", "crop": [0.47, 0.42, 0.75]},
    "landscape": {"commons": "File:Ruby Mountain refected in Diablo Lake.jpg", "crop": [0.45, 0.5, 1.0]},
    "detail": {"commons": "File:Speculum Feather from Pacific Black Duck.jpg", "crop": [0.4, 0.5, 1.0]},
    "sunset": {"commons": "File:Sunset rolling waves.jpg", "crop": [0.5, 0.5, 1.0]},
    "colour": {"commons": "File:Ara ararauna portrait Rhodes.jpg", "crop": [0.55, 0.5, 1.0]},
    "flower": {"commons": "File:Fleabane With Black Background.jpg", "crop": [0.5, 0.5, 0.9]},
    "greenscreen": {"from": "flower", "backdrop": "#00b140", "cut": [0.12, 0.3]},
    "blackscreen": {"from": "flower", "backdrop": "#000000", "cut": [0.12, 0.3]}
  },
  "effects": {
    "huesaturation": {"photo": "colour", "params": {"hue": 120, "saturation": 1.3}, "split": 0.4},
    "brightnesscontrast": {"photo": "landscape", "params": {"brightness": 0.05, "contrast": 0.45}, "split": 0.4},
    "solid": {"photo": "portrait", "params": {"amount": 0.55}},
    "backdrop": {"photo": "colour", "under": "landscape", "split": 0.4},
    "gradientoverlay": {"photo": "landscape", "params": {"opacity": 0.55}, "split": 0.4},
    "fourcolor": {"photo": "portrait", "params": {"point1": [-150, -150], "point2": [150, -150], "point3": [150, 150], "point4": [-150, 150], "opacity": 0.6, "blend": 3}},
    "colorbalance": {"photo": "landscape", "params": {"shadows": "#1050c0", "highlights": "#ffa040", "amount": 1}, "split": 0.4},
    "colorwheels": {"photo": "landscape", "split": 0.4},
    "splittone": {"photo": "landscape", "split": 0.4},
    "temperature": {"photo": "landscape", "split": 0.4},
    "duotone": {"photo": "portrait", "params": {"color1": "#2b1055", "color2": "#ffcc33"}},
    "gradientmap": {"photo": "portrait"},
    "exposure": {"photo": "landscape", "params": {"stops": 0.8}, "split": 0.4},
    "invert": {"photo": "landscape"},
    "levels": {"photo": "sunset", "params": {"inBlack": 0.25, "inWhite": 0.75}, "split": 0.4},
    "posterize": {"photo": "colour", "params": {"levels": 4}},
    "sepia": {"photo": "portrait"},
    "threshold": {"photo": "portrait", "params": {"level": 0.5}},
    "tint": {"photo": "landscape", "params": {"shadowColor": "#1a2a6c", "highlightColor": "#fdbb2d"}},
    "blur": {"photo": "landscape", "params": {"strength": 14}},
    "directionalblur": {"photo": "landscape", "params": {"blurLength": 40, "angle": 30}},
    "motionblur": {"photo": "landscape", "params": {"length": 60}},
    "radialblur": {"photo": "sunset", "params": {"strength": 1, "center": [0.45, 0.42]}},
    "twirl": {"photo": "portrait", "params": {"center": [0.5, 0.42], "radius": 0.42, "angle": 120}},
    "bulge": {"photo": "portrait", "params": {"center": [0.5, 0.45], "strength": 0.7, "radius": 0.5}},
    "glitch": {"photo": "portrait", "params": {"intensity": 1, "blockHeight": 12}, "frame": 10},
    "noisedisplace": {"photo": "colour", "params": {"amount": 35, "scale": 35}},
    "ripple": {"photo": "portrait", "params": {"amplitude": 6, "wavelength": 6}},
    "wavewarp": {"photo": "portrait", "params": {"amplitude": 10, "wavelength": 70, "direction": 45}},
    "stretch": {"photo": "portrait", "params": {"stretch": 120, "angle": 90}},
    "glow": {"photo": "flower", "params": {"strength": 16, "intensity": 0.7}},
    "lightglow": {"photo": "sunset", "params": {"blur": 24, "threshold": 0.55}},
    "softglow": {"photo": "flower", "params": {"blur": 12}, "split": 0.4},
    "edgedetect": {"photo": "landscape", "params": {"strength": 1.5}},
    "emboss": {"photo": "detail", "params": {"strength": 2}},
    "halftone": {"photo": "portrait", "params": {"cell": 8}},
    "lensflare": {"photo": "landscape", "params": {"center": [0.3, 0.25], "radius": 0.3, "brightness": 1.2}},
    "pixelate": {"photo": "portrait", "params": {"blockSize": 12}},
    "rgbsplit": {"photo": "portrait", "params": {"splitDistance": 10}},
    "scanlines": {"photo": "sunset", "params": {"spacing": 8, "darkness": 0.6}},
    "sharpen": {"photo": "detail", "params": {"amount": 2.5, "radius": 1.5}, "split": 0.4},
    "vignette": {"photo": "landscape", "params": {"amount": 0.8, "radius": 0.7, "softness": 0.6}},
    "filmgrain": {"photo": "portrait", "params": {"amount": 0.4}, "local": "grain"},
    "dissolve": {"photo": "colour", "params": {"progress": 0.45, "grain": 8}},
    "static": {"photo": "landscape", "params": {"amount": 0.4}},
    "blink": {"photo": "colour", "frames": [1, 5, 9, 13]},
    "kaleidoscope": {"photo": "colour", "params": {"center": [0.4, 0.6]}},
    "mirror": {"photo": "colour"},
    "tile": {"photo": "colour"},
    "chromakey": {"photo": "greenscreen", "under": "landscape", "params": {"key": "#00b140"}, "split": 0.4},
    "lumakey": {"photo": "blackscreen", "under": "landscape", "params": {"threshold": 0.15}, "split": 0.4},
    "unsharpmask": {"photo": "detail", "params": {"strength": 0.6, "amount": 2}, "split": 0.4},
    "highlightshadow": {"photo": "landscape", "params": {"highlights": 0.6, "shadows": 1.6}, "split": 0.4},
    "denoise": {"photo": "detail", "params": {"strength": 1, "radius": 3}, "split": 0.4},
    "flicker": {"photo": "colour", "frames": [1, 5, 9, 13]}
  }
}
