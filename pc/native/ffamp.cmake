set(FFAMP "${AM_ROOT}/third_party/FFamp" CACHE PATH "FFamp source")
if(FFAMP_DEPS)
    list(PREPEND CMAKE_PREFIX_PATH "${FFAMP_DEPS}")
endif()
add_subdirectory("${FFAMP}" ffamp EXCLUDE_FROM_ALL)
file(GLOB FFAMP_NASM "${FFAMP}/src/h264/x86/*.asm")
set_source_files_properties(${FFAMP_NASM} DIRECTORY "${FFAMP}" PROPERTIES LANGUAGE ASM_NASM)
file(STRINGS "${FFAMP}/src/h264/ffbase.c" FFAMP_AV REGEX "^[a-zA-Z][^;(]*[ *]av_[a-z0-9_]+\\(")
string(REGEX MATCHALL "av_[a-z0-9_]+\\(" FFAMP_AV "${FFAMP_AV}")
list(TRANSFORM FFAMP_AV REPLACE "^(av_[a-z0-9_]+)\\($" "\\1=ffamp_\\1")
list(REMOVE_DUPLICATES FFAMP_AV)
target_compile_definitions(ffamp_lib PRIVATE ${FFAMP_AV})
target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/video_ffamp.cpp" "${AM_ROOT}/pc/native/media_ffamp.cpp")
target_link_libraries(amdesktop PRIVATE ffamp_lib)
