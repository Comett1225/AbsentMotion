set(WIN "${AM_ROOT}/windows/native")
set(SKIA_LIB_DIR "${SKIA}/out/win-x64" CACHE PATH "Skia libraries")
set(FFMPEG_DIR "$ENV{FFMPEG_DIR}" CACHE PATH "FFmpeg development files")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/gpu_vulkan.cpp" "${WIN}/file_dialog_win.cpp")
target_compile_definitions(amdesktop PRIVATE _USE_MATH_DEFINES NOMINMAX)
target_compile_options(amdesktop PRIVATE /w /GR- /EHs-c- /utf-8 /O2)
target_include_directories(amdesktop PRIVATE "${WIN}/compat" "${SKIA}/third_party/externals/vulkan-headers/include" "$ENV{JAVA_HOME}/include/win32")
file(GLOB SKIA_WIN_LIBS "${SKIA_LIB_DIR}/*.lib")
target_link_libraries(amdesktop PRIVATE ${SKIA_WIN_LIBS} dwrite d2d1 dxgi d3d11 windowscodecs ole32 oleaut32 uuid usp10 user32 gdi32 advapi32 shell32 shlwapi)
if(FFMPEG_DIR AND EXISTS "${FFMPEG_DIR}/include/libavcodec/avcodec.h")
    target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/video.cpp" "${AM_ROOT}/pc/native/video_copy.cpp")
    target_include_directories(amdesktop PRIVATE "${FFMPEG_DIR}/include")
    target_link_directories(amdesktop PRIVATE "${FFMPEG_DIR}/lib")
    target_link_libraries(amdesktop PRIVATE avformat avcodec avutil swscale)
endif()
target_sources(amdesktop PRIVATE "${WIN}/window_theme_win.cpp")
target_link_libraries(amdesktop PRIVATE dwmapi)
