#include <windows.h>

1 ICON "@AM_ICON@"
1 RT_MANIFEST "@AM_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @AM_VERSION_COMMAS@
PRODUCTVERSION @AM_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AbsentMotion"
            VALUE "FileDescription", "AbsentMotion Setup"
            VALUE "FileVersion", "@AM_VERSION@"
            VALUE "ProductName", "AbsentMotion"
            VALUE "ProductVersion", "@AM_VERSION@"
            VALUE "OriginalFilename", "AbsentMotionSetup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
