set(SKIA_LIBS "${SKIA}/out/linux-x64" CACHE PATH "Skia libraries")
find_package(PkgConfig REQUIRED)
pkg_check_modules(AV IMPORTED_TARGET libavformat libavcodec libavutil libswscale)
pkg_check_modules(FONTS REQUIRED IMPORTED_TARGET fontconfig freetype2)
target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/gpu_vulkan.cpp")
target_compile_options(amdesktop PRIVATE -O2 -fno-rtti -fno-exceptions -fPIC -w)
target_include_directories(amdesktop PRIVATE "$ENV{JAVA_HOME}/include/linux" "${SKIA}/third_party/externals/vulkan-headers/include")
target_link_libraries(amdesktop PRIVATE -Wl,--start-group)
foreach(lib skparagraph skshaper skunicode_icu skunicode_core skia pathops skcms harfbuzz icu png jpeg webp wuffs zlib expat)
    target_link_libraries(amdesktop PRIVATE "${SKIA_LIBS}/lib${lib}.a")
endforeach()
target_link_libraries(amdesktop PRIVATE -Wl,--end-group PkgConfig::FONTS dl pthread)
if(AV_FOUND)
    target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/video.cpp" "${AM_ROOT}/pc/native/video_copy.cpp")
    target_link_libraries(amdesktop PRIVATE PkgConfig::AV)
endif()
set_target_properties(amdesktop PROPERTIES BUILD_RPATH "$ORIGIN")
