if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(SKIA_LIBS "${SKIA}/out/linux-arm64" CACHE PATH "Skia libraries")
else()
    set(SKIA_LIBS "${SKIA}/out/linux-x64" CACHE PATH "Skia libraries")
endif()
find_package(PkgConfig REQUIRED)
pkg_check_modules(AV IMPORTED_TARGET libavformat libavcodec libavutil libswscale)
pkg_check_modules(FONTS REQUIRED IMPORTED_TARGET fontconfig)
target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/gpu_vulkan.cpp" "${AM_ROOT}/linux/native/file_dialog_linux.cpp")
target_compile_definitions(amdesktop PRIVATE SK_R32_SHIFT=16)
target_compile_options(amdesktop PRIVATE -O2 -fno-rtti -fno-exceptions -fPIC -w)
target_include_directories(amdesktop PRIVATE "$ENV{JAVA_HOME}/include/linux" "${SKIA}/third_party/externals/vulkan-headers/include")
target_link_libraries(amdesktop PRIVATE -Wl,--start-group)
foreach(lib skparagraph skshaper skunicode_icu skunicode_core skia pathops skcms harfbuzz freetype2 icu png jpeg webp wuffs zlib expat)
    target_link_libraries(amdesktop PRIVATE "${SKIA_LIBS}/lib${lib}.a")
endforeach()
target_link_libraries(amdesktop PRIVATE -Wl,--end-group PkgConfig::FONTS dl pthread)
if(AV_FOUND)
    target_sources(amdesktop PRIVATE "${AM_ROOT}/pc/native/video.cpp" "${AM_ROOT}/pc/native/video_copy.cpp")
    target_link_libraries(amdesktop PRIVATE PkgConfig::AV)
endif()
target_sources(amdesktop PRIVATE "${AM_ROOT}/linux/native/glibc_compat.c")
set_source_files_properties("${AM_ROOT}/linux/native/glibc_compat.c" PROPERTIES COMPILE_OPTIONS "-std=c11")
target_link_options(amdesktop PRIVATE -static-libstdc++ -static-libgcc -Wl,--exclude-libs,ALL -Wl,--wrap=fmod -Wl,--wrap=fmodf)
set_target_properties(amdesktop PROPERTIES BUILD_WITH_INSTALL_RPATH ON INSTALL_RPATH "$ORIGIN")
