   "pixels": true
  },
  {
   "id": "color",
   "label": "Color",
   "type": "color",
   "default": "#000000"
  },
  {
   "id": "style",
   "label": "Style",
   "type": "choice",
   "default": 0,
   "options": [
    "Outline",
    "Fill",
    "Bands"
   ],
   "when": {
    "style": [
     1,
     2
    ]
   }
  }
 ]
}
